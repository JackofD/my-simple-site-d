{
  "name": "my-simple-site-d",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "wrangler && vite build",
    "preview": "npm run build && wrangler dev",
    "prepare": "svelte-kit sync || echo ''",
    "clean": "node -e \"const fs=require('fs');['.svelte-kit/output','.svelte-kit/cloudflare','.svelte-kit/cloudflare-tmp'].forEach(p=>fs.rmSync(p,{recursive:true,force:true}))\"",
    "check": "wrangler types --check && svelte-kit sync && npm run clean && svelte-check --tsconfig ./jsconfig.json",
    "check:watch": "svelte-kit sync && npm run clean && svelte-check --tsconfig ./jsconfig.json --watch",
    "gen": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.48.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^25.6.0",
    "mdsvex": "^0.12.6",
    "svelte": "^5.42.2",
    "svelte-check": "^4.3.3",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "wrangler": "^4.81.0"
  }
}